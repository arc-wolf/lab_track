# LabTrack Production Environment Variables Template

# Core Django Environment & Security Settings
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-64-character-secret-key-here
DJANGO_ALLOWED_HOSTS=labtrack.yourdomain.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://labtrack.yourdomain.com

# SSL Hardening (Enable in production behind HTTPS)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Database Configuration (PostgreSQL / MySQL / SQLite)
# Example PostgreSQL: postgres://username:password@localhost:5432/labtrack_db
DATABASE_URL=
DJANGO_DB_CONN_MAX_AGE=60

# Redis & Cache Backend
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
DJANGO_CACHE_BACKEND=redis
DJANGO_CACHE_URL=redis://127.0.0.1:6379/1

# SMTP Mail Server Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=your-lab-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-app-password
DJANGO_FROM_EMAIL=your-lab-email@gmail.com

# Gunicorn Production Server Settings
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info

# Throttling & Rate Limits
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
SIGNUP_OTP_VERIFY_RATE_LIMIT=10
PASSWORD_RESET_OTP_VERIFY_RATE_LIMIT=10
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
OTP_RESEND_RATE_LIMIT=5
API_TOKEN_ISSUE_RATE_LIMIT=20
