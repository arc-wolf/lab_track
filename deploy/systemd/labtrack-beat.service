[Unit]
Description=LabTrack Celery Beat Scheduler Service
After=network.target redis.service postgresql.service labtrack-worker.service

[Service]
Type=simple
User=labtrack
Group=labtrack
WorkingDirectory=/var/www/labtrack
EnvironmentFile=/var/www/labtrack/.env
ExecStart=/var/www/labtrack/venv/bin/celery -A config beat -l info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
