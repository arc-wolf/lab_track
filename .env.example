DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_TRUST_X_FORWARDED_FOR=True

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_HTTPONLY=False
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_X_FRAME_OPTIONS=DENY

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=your-email@example.com
DJANGO_EMAIL_HOST_PASSWORD=replace-with-app-password
DJANGO_FROM_EMAIL=your-email@example.com

DJANGO_CACHE_BACKEND=redis
DJANGO_CACHE_URL=redis://127.0.0.1:6379/1
DJANGO_SESSION_ENGINE=django.contrib.sessions.backends.cached_db

AUTH_RATE_LIMIT_WINDOW_SECONDS=600
SIGNUP_OTP_VERIFY_RATE_LIMIT=10
PASSWORD_RESET_OTP_VERIFY_RATE_LIMIT=10
PASSWORD_RESET_REQUEST_RATE_LIMIT=5
OTP_RESEND_RATE_LIMIT=5
API_TOKEN_ISSUE_RATE_LIMIT=20
API_TOKEN_MAX_AGE_DAYS=30
API_TOKEN_IDLE_TIMEOUT_SECONDS=1209600
