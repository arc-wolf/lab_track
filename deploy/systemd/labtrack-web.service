[Unit]
Description=LabTrack Gunicorn Web Server
After=network.target redis.service postgresql.service

[Service]
Type=notify
User=labtrack
Group=labtrack
WorkingDirectory=/var/www/labtrack
EnvironmentFile=/var/www/labtrack/.env
ExecStart=/var/www/labtrack/venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
